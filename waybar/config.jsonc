{
  "layer": "bottom",
  "position": "top",
  "height": 44,
  "width": 1912,
  "spacing": 4,
  "margin": 10,
  "modules-left": ["custom/power", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "backlight",
    "wireplumber",
    "network",
    "bluetooth",
    "cpu",
    "memory",
    "battery",
  ],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "show-special": true,
    "format": "{name}",
    "format-icons": {
      "urgent": "",
      "focused": "",
      "default": "",
      "magic": "🗇",
    },
  },
  "hyprland/window": {
    "icon": true,
    "format": "{class}",
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞 ", "󰃝 ", "󰃟 ", "󰃠 "],
  },
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-source": "{volume}%",
    "format-source-muted": " {volume}%",
    "format-icons": {
      "default": ["", " ", "󰕾", " "],
    },
    "on-click": "pavucontrol",
    "on-click-right": "helvum",
  },
  "network": {
    "format-wifi": "  {essid} ({signalStrength}%)",
    "format-ethernet": " {ipaddr}/{cidr}",
    "format-linked": " {ifname} (No IP)",
    "format-disconnected": "󰖪 --",
    "format-alt": " :{bandwidthUpBytes}][ :{bandwidthDownBytes}",
    "tooltip-format": "{ifname} via {gwaddr}",
  },
  "bluetooth": {
    "tooltip": true,
    "format": " Connected ({num_connections})",
    "format-on": " On",
    "format-off": "󰂲 Off",
    "format-disabled": "",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
  },
  "cpu": {
    "interval": 10,
    "format": "  {usage}%",
    "tooltip": true,
  },
  "memory": {
    "interval": 10,
    "format": "  {percentage}%",
    "tooltip": true,
    "tooltip-format": "MEM: {used:0.1f}GiB ({percentage}%)\nSWAP: {swapUsed:0.1f}GiB ({swapPercentage}%)",
  },
  "battery": {
    "bat": "BAT1",
    "tooltip": true,
    "interval": 30,
    "states": {
      "good": 100,
      "warning": 40,
      "critical": 15,
    },
    "design-capacity": false,
    "format": "{icon} {capacity}%",
    "format-full": " {icon} {capacity}%",
    "format-charging": "󱐋{icon} {capacity}% ",
    "format-plugged": "{icon} {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": ["󰁻", " 󰁽", "󰁿", "󰂁", "󰁹"],
  },
  "clock": {
    "interval": 1,
    "format": "{:%H:%M:%S | %b %d, %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode-mon-col": 4,
      "weeks-pos": "left",
      "format": {
        "months": "<span color='#ffead3'><b><u>{}</u></b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#181825' background='#ff6699'><b>{}</b></span>",
      },
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },
  "custom/power": {
    "format": " ",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
    "menu-actions": {
      "shutdown": "systemctl poweroff",
      "reboot": "systemctl reboot",
      "suspend": "systemctl suspend",
      "hibernate": "systemctl hibernate",
      "logout": "hyprctl dispatch exit",
    },
  },
}
