export PATH="$HOME/.local/bin:$PATH"

# ----------STARSHIP-PROMPT---------------
eval "$(starship init zsh)"
# ---- Fix Starship zle-keymap-select recursion bug ----
function starship_vi_mode_fix() {
  if [[ -z "$_zle_guard" ]]; then
    _zle_guard=1
    { starship_precmd &>/dev/null }
    zle reset-prompt
    unset _zle_guard
  fi
}
zle -N zle-keymap-select starship_vi_mode_fix
