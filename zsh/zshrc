# nohup
function nohup() {
	mkdir -p ~/nohup_log
	logfile=~/nohup_log/nohup_$(date +%Y-%m-%d).log
	command nohup "$@" >> "$logfile" 2>&1 &
}
# yazi
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

