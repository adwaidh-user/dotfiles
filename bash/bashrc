#### Prompt ###########################
sym="㉿" #symbol of prompt
bar_cr="34" #color of bars
sym_cr="31" #color of symbol
name_cr="37" #color of user & host
end_cr="37" #color of prompt end
dir_cr="36" #color of current directory

PS1='\[\e[0;${bar_cr}m\]
┌──(\[\e[1;${name_cr}m\]${user}\[\e[1;${sym_cr}m\]${sym}\[\e[1;${name_cr}m\]${hostname}\[\e[0;${bar_cr}m\])-[\[\e[0;${dir_cr}m\]\w\[\e[0;${bar_cr}m\]]
└─\[\e[1;${end_cr}m\]\$\[\e[0m\] '

eval "$(starship init bash)"
