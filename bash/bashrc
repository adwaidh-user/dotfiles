set -o vi
# Track vi mode in a variable for Starship
__update_keymap() {
  local keymap
  keymap=$(bind -v | grep 'set keymap' | awk '{print $3}')
  export KEYMAP="$keymap"
}

# Run the hook before each prompt
PROMPT_COMMAND="__update_keymap; $PROMPT_COMMAND"
