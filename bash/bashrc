# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc

# Variables
user=$USER
hostname=$HOSTNAME

#### Aliases ###########################

# common commands
alias ..='cd ..'
alias ls=lsd
alias ll='ls -lFh'
alias lm='ls | more'
alias la='ls -alFh --group-directories-first'
alias lsn='ls | cat -n'
alias mkdir='mkdir -pv'
alias cp='cp --preserve=all -v'
alias cpr='cp --preserve=all -Rv'
alias count='find . -type f -not -path "*/\.*" | wc -l'
alias count-all='find . -type f | wc -l'
alias fbig="find . -size +128M -type f -printf '%s %p\n'| sort -nr | head -16"
alias n='exec bash'
alias c='clear'
alias q='exit'

# system
alias cputemp='sensors | grep Core'
alias batteryreport='upower --monitor-detail'
alias poweroff='systemctl poweroff'
alias reboot='systemctl reboot'
alias df='duf'

# application shortcuts
alias cat=bat
alias myip='curl -s -m 5 https://ipleak.net/json/'
alias edit-nvim='nvim ~/.config/nvim'
alias edit-bash='nvim ~/.bashrc'
alias edit-kitty='nvim ~/.config/kitty/kitty.conf'
alias edit-git='git config --global --edit'
alias so-bash='source ~/.bashrc'
alias timenow='date +"%T"'
alias datenow='date +"%d-%m-%Y"'
nohup() {
	mkdir -p ~/nohup_log
	logfile=~/nohup_log/nohup_$(date +%Y-%m-%d).log
	command nohup "$@" >> "$logfile" 2>&1 &
}

# web
alias whatsap='nohup firefox https://web.whatsapp.com/'
alias chatGPT='nohup firefox https://chatgpt.com/'
alias claude-ai='nohup firefox https://claude.ai/'
alias perplexity='nohup firefox https://www.perplexity.ai/'

# Personal
alias clg='cd ~/Programming/College-Assignments/'

